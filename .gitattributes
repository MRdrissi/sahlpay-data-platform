# Normalisation des fins de ligne (équipe sous Windows, conteneurs sous Linux)
* text=auto

# Fichiers exécutés dans les conteneurs : toujours LF
*.sh         text eol=lf
*.py         text eol=lf
*.scala      text eol=lf
*.sbt        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.properties text eol=lf
Dockerfile   text eol=lf
.env.example text eol=lf

# Scripts Windows
*.ps1        text eol=crlf
*.bat        text eol=crlf

# Binaires (ne jamais modifier)
*.png     binary
*.jpg     binary
*.pdf     binary
*.jar     binary
*.parquet binary